# Server
NODE_ENV=development
PORT=8081
APP_ORIGIN=http://localhost:5174
LOG_LEVEL=info

# PostgreSQL (required for options-flow history)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepberg

# OpenAI-compatible AI provider (optional; AI features degrade gracefully)
# OpenAI: https://api.openai.com/v1
# Ollama: http://localhost:11434/v1
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Optional economic calendar provider
FINNHUB_API_KEY=

# Frontend development
BASE_PATH=/
API_PROXY_TARGET=http://localhost:8081
